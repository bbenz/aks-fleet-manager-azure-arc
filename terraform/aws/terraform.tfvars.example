# Copy to terraform.tfvars (gitignored) and adjust - or let
# scripts/03-init-plan.ps1 generate/merge this automatically from your .env
# and scripts/02-select-regions.ps1's region-selection output.
# No secrets belong in this file; all fields below are non-sensitive.

owner           = "your-name-or-team"
project         = "fleet-arc-demo"
environment     = "demo"
expiration_date = "2026-12-31"

# region is auto-selected by scripts/02-select-regions.ps1 unless you set
# AWS_REGION_OVERRIDE in .env - override here only for manual/offline runs.
# region = "us-east-1"

# Named profile / SSO / assume-role auth - never a static access key:
# aws_profile         = "fleet-arc-demo"
# aws_assume_role_arn = "arn:aws:iam::123456789012:role/fleet-arc-demo-terraform"

# Uncomment to hard-fail terraform plan/apply if the active credentials
# don't resolve to the account you expect:
# expected_account_id = "123456789012"

# vpc_cidr            = "10.60.0.0/16"
# cluster_version     = "1.35"
# node_instance_type  = "t3.large"
# node_desired_size   = 2
# node_capacity_type  = "ON_DEMAND"
# enable_aws_load_balancer_controller = true
