# ==============================================================================
# Fleet Manager + Arc Multicloud Demo — local bootstrap configuration
#
# Copy this file to `.env` and fill in values. `.env` is gitignored and is
# read ONLY by scripts/00-bootstrap-auth.ps1 and scripts/lib/*.ps1 helpers.
#
# docs/DEMO-RUNSHEET.md ("Configure your .env") explains which of these
# actually matter for a first run — start there.
#
# This file must never contain real secrets. Long-lived passwords/keys are
# NOT valid values for the CLOUD_*_BOOTSTRAP_* fields below — they are hints
# used to drive each cloud's OFFICIAL interactive login flow (browser/device
# code/MFA), never a direct programmatic credential exchange. See
# docs/AUTHENTICATION-AND-PERMISSIONS.md for details.
# ==============================================================================

# ---- Per-cloud enable toggles ------------------------------------------------
# Every scripts/*.ps1 step loops over only the clouds enabled here, so you can
# run this demo with any subset of Azure/AWS/GCP (e.g. Azure-only while you
# finish AWS/GCP console auth separately). All three default to true.
#
# ENABLE_AZURE must stay true: Azure hosts the Fleet Manager hub cluster that
# the AWS and GCP clusters are Arc-connected into and join as members.
ENABLE_AZURE=true
ENABLE_AWS=true
ENABLE_GCP=true

# ---- Naming / tagging (applies to every resource across all three clouds) ---
# Short, lowercase, alphanumeric + hyphen. Kept under 12 chars so it composes
# safely with cloud-specific suffixes/length limits (e.g. AKS DNS prefixes).
# Every resource is named <NAME_PREFIX>-<ENVIRONMENT>-<suffix>, so the defaults
# below produce flarc-demo-aks, flarc-demo-eks, flarc-demo-gke, etc. Change
# this if you share a subscription/account/project with anyone else.
NAME_PREFIX=flarc

# Resource owner tag/label value (e.g. your corporate email or alias).
OWNER=

# Free-text project tag applied everywhere.
PROJECT=fleet-arc-demo

# Environment tag/label. Leave as "demo" unless you fork this for another use.
ENVIRONMENT=demo

# ISO-8601 date (YYYY-MM-DD) after which this demo should be torn down.
# Used only as a metadata tag/label + reminder in reports; it does not
# automatically delete anything.
EXPIRATION_DATE=

# ---- Azure --------------------------------------------------------------------
# Optional safety assertions. When set, scripts verify `az account show`
# matches these before doing anything; when blank, the active `az` login
# context is used as-is (this is the documented default behavior).
AZURE_EXPECTED_TENANT_ID=
AZURE_EXPECTED_SUBSCRIPTION_ID=

# Optional explicit region override. Leave blank to allow automatic
# discovery (scripts/02-select-regions.ps1) based on AKS/Fleet/Arc/quota
# availability.
AZURE_REGION_OVERRIDE=

# Resource group name used for Fleet Manager, AKS, and Arc-connected cluster
# resources. Leave blank to derive from NAME_PREFIX.
AZURE_RESOURCE_GROUP=

# ---- AWS ------------------------------------------------------------------
# Named CLI profile to use. Prefer an AWS SSO profile (`aws configure sso`)
# or a profile backed by role assumption. Do NOT put access keys here.
AWS_PROFILE=

# Optional: IAM role ARN to assume from AWS_PROFILE's base credentials.
AWS_ASSUME_ROLE_ARN=

# Optional explicit region override. Leave blank for automatic discovery.
AWS_REGION_OVERRIDE=

# Safety assertion: expected 12-digit AWS account ID. Leave blank to skip.
AWS_EXPECTED_ACCOUNT_ID=

# Hints only (NOT used for programmatic auth) — the console username you
# will use if scripts/00-bootstrap-auth.ps1 needs to prompt you through
# `aws configure sso` or `aws configure` interactively.
AWS_BOOTSTRAP_USERNAME_HINT=

# ---- GCP ------------------------------------------------------------------
# Target GCP project ID (not project name/number).
GCP_PROJECT_ID=

# Optional: service account to impersonate for ADC
# (roles/iam.serviceAccountTokenCreator required on your user first).
# Leave blank to use your own `gcloud auth application-default login` user
# credentials directly.
GCP_IMPERSONATE_SERVICE_ACCOUNT=

# Optional explicit region/zone override. Leave blank for automatic discovery.
GCP_REGION_OVERRIDE=
GCP_ZONE_OVERRIDE=

# Hints only (NOT used for programmatic auth) — the account email you will
# use for `gcloud auth login` / `gcloud auth application-default login`.
GCP_BOOTSTRAP_ACCOUNT_HINT=

# ---- Arc onboarding ---------------------------------------------------------
# Resource group + region for Arc-connected cluster resources (EKS/GKE).
# Leave blank to reuse AZURE_RESOURCE_GROUP / the discovered Azure region.
ARC_RESOURCE_GROUP=
ARC_REGION_OVERRIDE=
